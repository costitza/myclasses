@model EventHub.Models.Event

@{
    ViewBag.Title = "Adăugare eveniment";
}

<h2 class="text-center mt-5">Adăugare eveniment</h2>

<br />

<div class="container mt-5">
    <div class="row">
        <div class="col-6 offset-3">

            <form method="post" asp-controller="Events" asp-action="New">

                <div class="form-group">
                    <label asp-for="Title" class="form-label">Titlul evenimentului</label>
                    <br />
                    <input asp-for="Title" class="form-control" />
                    <br /><br />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Descrierea evenimentului</label>
                    <br />
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <br /><br />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Date" class="form-label">Data și ora</label>
                    <br />
                    <input asp-for="Date" class="form-control" value="" />
                    <br /><br />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Location" class="form-label">Locația</label>
                    <br />
                    <input asp-for="Location" class="form-control" />
                    <br /><br />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Selectați categoria</label>
                    <br />
                    <select asp-for="CategoryId" asp-items="Model.Categ" class="form-select">
                        <option value="">Selectați categoria</option>
                    </select>
                    <br />
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <button class="btn btn-success" type="submit">Adaugă evenimentul</button>

            </form>
            
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    </div>
</div>

