@model EventHub.Models.Category

@{
    ViewBag.Title = "Editare categorie";
}

<h2 class="text-center mt-5">Editare categorie</h2>

<br />

<div class="container mt-5">
    <div class="row">
        <div class="col-6 offset-3">

            <form method="post" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id">

                <div class="form-group">
                    <label asp-for="CategoryName" class="form-label">Numele categoriei</label>
                    <br />
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                    <br /><br />
                </div>

                <button class="btn btn-success" type="submit">Modifică categoria</button>

            </form>

        </div>
    </div>
</div>
