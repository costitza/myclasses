@{
    ViewBag.Title = "Categorii";
}

<h2 class="text-center">Afișare categorii</h2>
<br />

@if (ViewBag.Message != null)
{
    <h2 class="alert alert-success p-3 rounded-3 text-center mb-5">@ViewBag.Message</h2>
}

<div class="d-flex justify-content-center gap-2">

    <a class="btn btn-outline-success" asp-controller="Events" asp-action="Index">Afișare evenimente</a>

    <a class="btn btn-outline-success" asp-controller="Categories" asp-action="New">Adaugă categorie</a>

</div>

<br />

@foreach (var category in ViewBag.Categories)
{
    <div class="card">

        <div class="card-body d-flex justify-content-between align-items-center">

            <h4 class="card-title mb-0"><i class="bi bi-tag"></i> @category.CategoryName</h4>

            <div class="d-flex gap-2">
                <a class="btn btn-success" asp-controller="Categories" asp-action="Show" asp-route-id="@category.Id">Afișare categorie</a>
                <a class="btn btn-outline-success" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id">Editează</a>
            </div>

        </div>

    </div>

    <br />
}
