<form method="post" action="/Events/Edit/@Model.Id">

    @Html.Label("Title", "Titlul evenimentului")
    <br />
    @Html.EditorFor(m => m.Title, new { htmlAttributes = new { @class = "form-control" } })
    <br /><br />

    @Html.Label("Description", "Descrierea evenimentului")
    <br />
    @Html.Editor("Description", new { htmlAttributes = new { @class = "form-control" } })
    <br /><br />

    @Html.Label("Date", "Data și ora")
    <br />
    @Html.Editor("Date", new { htmlAttributes = new { @class = "form-control" } })
    <br /><br />

    @Html.Label("Location", "Locația")
    <br />
    @Html.Editor("Location", new { htmlAttributes = new { @class = "form-control" } })
    <br /><br />

    <label>Selectați categoria</label>
    @Html.DropDownListFor(m => m.CategoryId,
    new SelectList(Model.Categ, "Value", "Text"),
