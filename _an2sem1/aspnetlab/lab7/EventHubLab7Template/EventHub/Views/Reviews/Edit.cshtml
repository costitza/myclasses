@* EXERCIȚIUL 8 – de analizat: recenzia vine ca Model (return View(rev)) *@
@model EventHub.Models.Review

@{
    ViewBag.Title = "Editare recenzie";
}

<h2 class="text-center mt-5">Editare recenzie</h2>

<br />

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-2">

            <form method="post" asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.Id">

                <div class="form-group">
                    <label asp-for="Content" class="form-label">Conținutul recenziei</label>
                    <br />
                    @* asp-for completează automat conținutul actual al recenziei *@
                    <textarea asp-for="Content" class="form-control"></textarea>
                    <br />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-success" type="submit"><i class="bi bi-pencil-square"></i> Modifică recenzia</button>
                    <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="Show" asp-route-id="@Model.EventId">Înapoi la eveniment</a>
                </div>

            </form>

        </div>
    </div>
</div>
